{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "remote",
  "description": "The DOCPAD pages may move, size and close their own frameless window - nothing else",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "https://docalvers.de/*",
      "https://malvers.github.io/*"
    ]
  },
  "permissions": [
    "core:window:allow-start-dragging",
    "core:window:allow-set-position",
    "core:window:allow-set-size",
    "core:window:allow-close"
  ]
}
