{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DOCPAD",
  "version": "1.1.0",
  "identifier": "de.docalvers.docpad",
  "build": {
    "frontendDist": "https://docalvers.de/docpad/app/"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "DOCPAD",
        "url": "https://docalvers.de/docpad/app/",
        "width": 1000,
        "height": 660,
        "center": true,
        "decorations": false,
        "shadow": false,
        "resizable": false,
        "create": false,
        "transparent": true,
        "maximizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Doc Alvers",
    "shortDescription": "DOCPAD",
    "longDescription": "Doc Alvers Mathe-Labor",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
